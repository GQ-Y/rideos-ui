{
  "name": "@rideos/ui",
  "version": "0.1.0",
  "description": "RideOS 管理后台专用 React 组件库（Go-UI Token）",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/rideos-ui.js",
  "module": "./dist/rideos-ui.js",
  "exports": {
    ".": {
      "import": {
        "development": "./src/index.js",
        "default": "./dist/rideos-ui.js"
      },
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^6.4.2"
  },
  "keywords": [
    "rideos",
    "react",
    "component-library",
    "admin",
    "go-ui"
  ],
  "license": "UNLICENSED"
}
