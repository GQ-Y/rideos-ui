{
  "name": "rideos-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "description": "RideOS 企业级 React PC 组件库 monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GQ-Y/rideos-ui.git"
  },
  "homepage": "https://github.com/GQ-Y/rideos-ui#readme",
  "bugs": {
    "url": "https://github.com/GQ-Y/rideos-ui/issues"
  },
  "scripts": {
    "dev": "pnpm --filter rideos-playground dev",
    "build": "pnpm --filter \"@rideos-ai/*\" build",
    "test": "pnpm --filter \"@rideos-ai/*\" test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:package && pnpm --filter rideos-playground build",
    "verify:package": "pnpm build && node scripts/verify-packages.mjs",
    "release:check": "node scripts/check-release-ready.mjs",
    "format": "prettier --write .",
    "gen": "node scripts/gen.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm release:check && pnpm verify && changeset publish"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0"
  }
}
