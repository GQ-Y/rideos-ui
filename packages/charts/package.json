{
  "name": "@rideos-ai/charts",
  "version": "0.3.0",
  "description": "RideOS 图表组件库:折线图/曲线图/柱状图/饼图(纯 SVG,零依赖)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GQ-Y/rideos-ui.git",
    "directory": "packages/charts"
  },
  "homepage": "https://github.com/GQ-Y/rideos-ui/tree/main/packages/charts#readme",
  "bugs": {
    "url": "https://github.com/GQ-Y/rideos-ui/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/rideos-charts.js",
  "module": "./dist/rideos-charts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rideos-charts.js",
      "default": "./dist/rideos-charts.js"
    },
    "./styles.css": "./dist/styles/charts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/copy-package-assets.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rideos",
    "react",
    "charts",
    "svg"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
